{
  "manifest_version": 3,
  "name": "SmartDM Integration",
  "version": "1.0.8",
  "description": "Send files and media to SmartDM.",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "activeTab",
    "webRequest",
    "cookies",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "smartdm-extension@smartdm.io",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_title": "Download with SmartDM"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://youtube.com/*"],
      "js": ["youtube_overlay.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://music.youtube.com/*"],
      "js": ["ytmusic_overlay.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.tiktok.com/*", "*://tiktok.com/*"],
      "js": ["tiktok_overlay.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://*.youtube.com/*", "*://*.tiktok.com/*", "*://tiktok.com/*"],
      "js": ["universal_overlay.js"],
      "run_at": "document_idle"
    }
  ]
}
