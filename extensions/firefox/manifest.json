{
  "manifest_version": 3,
  "name": "SmartDM Integration",
  "version": "1.0.8",
  "description": "Send files and media to SmartDM.",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "activeTab",
    "webRequest",
    "cookies",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "smartdm-extension@smartdm.io",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_title": "Download with SmartDM"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["smartdm_overlay.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
