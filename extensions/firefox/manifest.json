{
  "manifest_version": 3,
  "name": "SmartDM Integration",
  "version": "1.0.9",
  "description": "Send files and media to SmartDM.",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "activeTab",
    "webRequest",
    "cookies",
    "downloads",
    "*://music.youtube.com/*",
    "*://*.bilibili.com/*",
    "*://*.bilibili.tv/*",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "*://music.youtube.com/*",
    "*://*.bilibili.com/*",
    "*://*.bilibili.tv/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "SmartDM",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>",
        "*://music.youtube.com/*",
        "*://*.bilibili.com/*",
        "*://*.bilibili.tv/*"
      ],
      "js": [
        "modules/media_metadata.js",
        "sniffer.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>",
        "*://music.youtube.com/*",
        "*://*.bilibili.com/*",
        "*://*.bilibili.tv/*"
      ],
      "js": [
        "modules/media_metadata.js",
        "modules/utils.js",
        "modules/visual_mount.js",
        "modules/format_engine.js",
        "modules/appearance.js",
        "modules/overlay_ui.js",
        "modules/watcher.js",
        "smartdm_overlay.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sniffer.js"
      ],
      "matches": [
        "<all_urls>",
        "*://music.youtube.com/*",
        "*://*.bilibili.com/*",
        "*://*.bilibili.tv/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "smartdm-extension@smartdm.io",
      "strict_min_version": "128.0"
    }
  }
}
