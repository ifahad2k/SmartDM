{
  "manifest_version": 3,
  "name": "SmartDM Integration",
  "version": "1.0.9",
  "description": "Send files and media to SmartDM.",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "activeTab",
    "webRequest",
    "cookies",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Download with SmartDM"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "sniffer.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "modules/utils.js",
        "modules/visual_mount.js",
        "modules/format_engine.js",
        "modules/overlay_ui.js",
        "modules/watcher.js",
        "smartdm_overlay.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sniffer.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "smartdm-extension@smartdm.io",
      "strict_min_version": "128.0"
    }
  }
}
