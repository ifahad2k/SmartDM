<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmartDm.Desktop.Avalonia.App"
             xmlns:local="using:SmartDm.Desktop.Avalonia"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Quiet desktop utility palette -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackground">#EEF1F4</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarBackground">#F6F8FA</SolidColorBrush>
                    <SolidColorBrush x:Key="CardBackground">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="ElevatedBackground">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderColor">#DCE4EA</SolidColorBrush>
                    <SolidColorBrush x:Key="PrimaryText">#192633</SolidColorBrush>
                    <SolidColorBrush x:Key="SecondaryText">#617181</SolidColorBrush>
                    <SolidColorBrush x:Key="MutedText">#8594A2</SolidColorBrush>
                    <SolidColorBrush x:Key="PrimaryAccent">#2368C9</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentHover">#185BB5</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentLight">#EAF2FF</SolidColorBrush>
                    <SolidColorBrush x:Key="SuccessColor">#247751</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningColor">#9B6828</SolidColorBrush>
                    <SolidColorBrush x:Key="ErrorColor">#B94D4B</SolidColorBrush>
                    <SolidColorBrush x:Key="DangerColor">#B94D4B</SolidColorBrush>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackground">#121B24</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarBackground">#22303B</SolidColorBrush>
                    <SolidColorBrush x:Key="CardBackground">#1D2933</SolidColorBrush>
                    <SolidColorBrush x:Key="ElevatedBackground">#1D2933</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderColor">#3A4956</SolidColorBrush>
                    <SolidColorBrush x:Key="PrimaryText">#EEF3F6</SolidColorBrush>
                    <SolidColorBrush x:Key="SecondaryText">#AFBAC5</SolidColorBrush>
                    <SolidColorBrush x:Key="MutedText">#8999A8</SolidColorBrush>
                    <SolidColorBrush x:Key="PrimaryAccent">#84B4FF</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentHover">#A2C7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentLight">#263D57</SolidColorBrush>
                    <SolidColorBrush x:Key="SuccessColor">#8ACBA5</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningColor">#DBB47B</SolidColorBrush>
                    <SolidColorBrush x:Key="ErrorColor">#EF9693</SolidColorBrush>
                    <SolidColorBrush x:Key="DangerColor">#EF9693</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter, Segoe UI, Nirmala UI, sans-serif" />
        </Style>
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/SDM_2.0_logo.png" ToolTipText="SmartDM 2.0">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Open SmartDM" Click="OnOpenSmartDmClicked" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Add Download..." Click="OnAddDownloadClicked" />
                        <NativeMenuItem Header="Active Transfers Monitor" Click="OnActiveTransfersClicked" />
                        <NativeMenuItem Header="Preferences &amp; Settings..." Click="OnSettingsClicked" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Toggle Light / Dark" Click="OnToggleThemeClicked" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Exit SmartDM" Click="OnExitClicked" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
