<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SmartDm.Desktop.Avalonia.Views.DeleteConfirmDialog"
        Icon="/Assets/SDM_2.0_logo.png"
        Title="SmartDM 2.0 • Delete Download"
        Width="640" Height="430"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="36"
        Background="{DynamicResource ElevatedBackground}">

    <Grid RowDefinitions="36,*">
        <!-- Unified System Titlebar -->
        <Border Grid.Row="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="14,0" PointerPressed="OnTitleBarPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image Source="/Assets/SDM_2.0_logo.png" Width="18" Height="18" VerticalAlignment="Center" />
                    <TextBlock Text="SmartDM 2.0 • Delete Download" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" FontFamily="Cascadia Code, Consolas, monospace" />
                </StackPanel>
                <Border Grid.Column="2" Width="140" />
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto" Margin="24">
            <StackPanel Grid.Row="0" Spacing="16">
                <!-- Header Alert Banner -->
                <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Width="40" Height="40" Background="#1FD9383A" BorderBrush="#33DC2626" BorderThickness="1" CornerRadius="8" Margin="0,0,14,0">
                            <Image Source="/Assets/Icons/trash-red.png" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="Delete Download" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryText}" />
                            <TextBlock x:Name="HeaderPromptText" Text="How would you like to delete this download?" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- File Summary Card -->
                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Width="36" Height="36" Background="{DynamicResource AccentLight}" CornerRadius="6" Margin="0,0,12,0">
                            <Image x:Name="FileIconImage" Source="/Assets/Icons/disc-blue.png" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock x:Name="FileNameText" Text="Filename.zip" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource PrimaryText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="FilePathText" Text="C:\Users\Downloads\Filename.zip" FontSize="10.5" Foreground="{DynamicResource MutedText}" FontFamily="Cascadia Code, Consolas, monospace" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Two Choice Explanations (Matching previous version behavior) -->
                <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                    <!-- Soft Delete Explanation Box -->
                    <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Source="/Assets/Icons/inbox-gray.png" Width="13" Height="13" VerticalAlignment="Center" />
                                <TextBlock Text="Soft Delete" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource PrimaryText}" />
                            </StackPanel>
                            <TextBlock Text="Removes the item from SmartDM's list and history. The downloaded file remains safe on your disk." FontSize="10.5" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Permanent Delete Explanation Box -->
                    <Border Grid.Column="1" Background="#0ADC2626" BorderBrush="#30DC2626" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Source="/Assets/Icons/trash-red.png" Width="13" Height="13" VerticalAlignment="Center" />
                                <TextBlock Text="Permanent Delete" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource DangerColor}" />
                            </StackPanel>
                            <TextBlock Text="Removes the item from SmartDM and permanently erases all physical files and chunks from disk." FontSize="10.5" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Bottom Buttons Bar -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                <TextBlock Grid.Column="0" Text="Permanent deletion cannot be undone" FontSize="11" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" FontFamily="Cascadia Code, Consolas, monospace" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Click="OnCancelClicked" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="7" Padding="14,8" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" FontSize="12">
                        Cancel
                    </Button>
                    <Button Click="OnSoftDeleteClicked" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="7" Padding="14,8">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Image Source="/Assets/Icons/close-gray.png" Width="11" Height="11" VerticalAlignment="Center" />
                            <TextBlock Text="Soft Delete" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnPermanentDeleteClicked" Background="#DC2626" CornerRadius="7" Padding="14,8">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Image Source="/Assets/Icons/trash-white.png" Width="12" Height="12" VerticalAlignment="Center" />
                            <TextBlock Text="Permanent Delete" FontWeight="Bold" FontSize="12" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
