<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartDm.Desktop.Avalonia.ViewModels"
        xmlns:models="using:SmartDm.Desktop.Avalonia.Models"
        x:Class="SmartDm.Desktop.Avalonia.Views.AddDownloadDialog"
        x:DataType="vm:AddDownloadViewModel"
        Icon="/Assets/SDM_2.0_logo.png"
        Title="SmartDM 2.0 • Add New Download Task"
        Width="800"
        SizeToContent="Height"
        MinHeight="480"
        MaxHeight="660"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="36"
        Background="{DynamicResource ElevatedBackground}">

    <Grid RowDefinitions="36,*,Auto">
        <!-- Unified Native Titlebar (Extended Client Area) -->
        <Border Grid.Row="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="14,0" PointerPressed="OnTitleBarPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image Source="/Assets/SDM_2.0_logo.png" Width="18" Height="18" VerticalAlignment="Center" />
                    <TextBlock Text="SmartDM 2.0 • Add New Download Task" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" FontFamily="Cascadia Code, Consolas, monospace" />
                    <Border Background="{DynamicResource BorderColor}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="Smart Probe Engine" FontSize="10" Foreground="{DynamicResource SecondaryText}" FontFamily="Cascadia Code, Consolas, monospace" />
                    </Border>
                </StackPanel>
                <!-- Right column leaves room for native OS caption buttons (minimize, maximize, close) -->
                <Border Grid.Column="2" Width="140" />
            </Grid>
        </Border>

        <!-- Dialog Body -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="22,16,22,12">
            <StackPanel Spacing="16">
                <!-- Source URL -->
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="SOURCE DOWNLOAD URL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" />
                        <Button Grid.Column="1" Command="{Binding PasteClipboardCommand}" Background="Transparent" BorderThickness="0" Padding="0">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Image Source="/Assets/Icons/paste-blue.png" Width="12" Height="12" VerticalAlignment="Center" />
                                <TextBlock Text="Paste from Clipboard" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding Url}" Background="{DynamicResource SidebarBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}" CornerRadius="7" Height="34" VerticalContentAlignment="Center" FontSize="12" FontFamily="Cascadia Code, Consolas, monospace" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Command="{Binding ProbeUrlCommand}" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="7" Padding="12,7" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryText}">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <Image Source="/Assets/Icons/gauge-blue.png" Width="13" Height="13" VerticalAlignment="Center" />
                                <TextBlock Text="Probe Link" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <!-- Probe Status Pill -->
                    <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                        <TextBlock Text="{Binding ProbeStatus}" FontSize="11" Foreground="{DynamicResource SuccessColor}" FontWeight="SemiBold" FontFamily="Cascadia Code, Consolas, monospace" />
                    </Border>
                </StackPanel>

                <!-- Format / Resolution Selector (Visible for media downloads) -->
                <StackPanel Spacing="6" IsVisible="{Binding IsMediaFormatSelectorVisible}">
                    <TextBlock Text="VIDEO FORMAT &amp; RESOLUTION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" />
                    <ComboBox ItemsSource="{Binding AvailableFormats}"
                              SelectedItem="{Binding SelectedFormat}"
                              HorizontalAlignment="Stretch"
                              Height="34"
                              CornerRadius="7"
                              Background="{DynamicResource SidebarBackground}"
                              Foreground="{DynamicResource PrimaryText}"
                              BorderBrush="{DynamicResource BorderColor}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="models:MediaFormatItem">
                                <Grid ColumnDefinitions="*,Auto" Margin="4,2">
                                    <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding FormattedSize}" Foreground="{DynamicResource PrimaryAccent}" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0,0,0" FontFamily="Cascadia Code, Consolas, monospace" />
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- File Name & Category -->
                <Grid ColumnDefinitions="2*,*">
                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                        <TextBlock Text="SAVE AS FILENAME" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" />
                        <TextBox Text="{Binding FileName}" Background="{DynamicResource SidebarBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}" CornerRadius="7" Height="34" VerticalContentAlignment="Center" FontSize="12" FontFamily="Cascadia Code, Consolas, monospace" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="CATEGORY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" />
                        <TextBox Text="{Binding Category}" Background="{DynamicResource SidebarBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}" CornerRadius="7" Height="34" VerticalContentAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Grid>

                <!-- Save Destination -->
                <StackPanel Spacing="6">
                    <TextBlock Text="SAVE DESTINATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding SavePath}" Background="{DynamicResource SidebarBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}" CornerRadius="7" Height="34" VerticalContentAlignment="Center" FontSize="12" FontFamily="Cascadia Code, Consolas, monospace" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Command="{Binding BrowseDestinationCommand}" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="7" Padding="12,7" FontSize="12" Foreground="{DynamicResource PrimaryText}">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <Image Source="/Assets/Icons/folder-gray.png" Width="13" Height="13" VerticalAlignment="Center" />
                                <TextBlock Text="Browse..." VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding TargetDriveDescription}" FontSize="10.5" Foreground="{DynamicResource MutedText}" />
                        <TextBlock Grid.Column="1" Text="{Binding AvailableFreeSpaceFormatted}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SuccessColor}" />
                    </Grid>
                </StackPanel>

                <!-- Multi-Source Mirror Cluster Panel -->
                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="9" Padding="14">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Image Source="/Assets/Icons/browser-gray.png" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="Multi-Source Mirror Cluster" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" />
                                <Border Background="#1A16A34A" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="Active (3 Nodes)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessColor}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="+ Add Mirror Node" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Center" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding MirrorNodes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:MirrorNode">
                                    <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,2">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Url}" FontSize="11" Foreground="{DynamicResource PrimaryText}" FontFamily="Cascadia Code, Consolas, monospace" />
                                            <TextBlock Grid.Column="1" Text="{Binding FormattedPing}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessColor}" FontFamily="Cascadia Code, Consolas, monospace" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Threads Stepper & Hash -->
                        <Grid ColumnDefinitions="*,*" Margin="0,6,0,0">
                            <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                                <TextBlock Text="PARALLEL DOWNLOAD THREADS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="7">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Command="{Binding StepThreadsCommand}" CommandParameter="-1" Background="Transparent" BorderThickness="0" Padding="10,6" Content="-" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" />
                                            <TextBlock Text="{Binding ParallelThreads}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" Margin="6,0" FontFamily="Cascadia Code, Consolas, monospace" />
                                            <Button Command="{Binding StepThreadsCommand}" CommandParameter="1" Background="Transparent" BorderThickness="0" Padding="10,6" Content="+" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Recommended 16x" FontSize="11" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
                                <TextBlock Text="EXPECTED SHA-256 (OPTIONAL)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" />
                                <TextBox Text="{Binding ExpectedHash}" Watermark="Paste hash to auto-verify..." Background="{DynamicResource SidebarBackground}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource BorderColor}" CornerRadius="7" Height="34" VerticalContentAlignment="Center" FontSize="11" FontFamily="Cascadia Code, Consolas, monospace" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Pinned Bottom Action Bar (Row 2 - Zero Dead Space) -->
        <Border Grid.Row="2" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="22,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Command="{Binding CancelCommand}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="7" Padding="16,8" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Content="Cancel" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <Button Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="7" Padding="14,8" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Content="Add to Queue" />
                    <Button Command="{Binding StartDownloadCommand}" Background="{DynamicResource PrimaryAccent}" Foreground="White" CornerRadius="7" Padding="18,8" FontSize="12.5" FontWeight="Bold">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Image Source="/Assets/Icons/play-white.png" Width="12" Height="12" VerticalAlignment="Center" />
                            <TextBlock Text="Start Download Now (Enter)" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>