<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SmartDm.Desktop.Avalonia.Views.FileCollisionDialog"
        Icon="/Assets/SDM_2.0_logo.png"
        Title="SmartDM 2.0 • File Collision Detected"
        Width="660" Height="480"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="36"
        Background="{DynamicResource ElevatedBackground}">

    <Grid RowDefinitions="36,*">
        <!-- Unified System Titlebar -->
        <Border Grid.Row="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image Source="/Assets/SDM_2.0_logo.png" Width="18" Height="18" VerticalAlignment="Center" />
                    <TextBlock Text="SmartDM 2.0 • Target File Collision" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" FontFamily="Cascadia Code, Consolas, monospace" />
                </StackPanel>
                <Border Grid.Column="2" Width="140" />
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto" Margin="24">
            <StackPanel Grid.Row="0" Spacing="16">
                <!-- Header Alert Banner -->
                <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Width="42" Height="42" Background="#1FD97706" BorderBrush="#33F59E0B" BorderThickness="1" CornerRadius="8" Margin="0,0,14,0">
                            <Image Source="/Assets/Icons/danger-red.png" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="File Already Exists in Target Folder" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryText}" />
                            <TextBlock x:Name="HeaderPromptText" Text="A file with this name already exists in the chosen destination folder." FontSize="11.5" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Target File Banner -->
                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Width="36" Height="36" Background="{DynamicResource AccentLight}" CornerRadius="6" Margin="0,0,12,0">
                            <Image x:Name="FileIconImage" Source="/Assets/Icons/disc-blue.png" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock x:Name="FileNameText" Text="Filename.zip" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource PrimaryText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="FilePathText" Text="C:\Users\Downloads\Filename.zip" FontSize="10.5" Foreground="{DynamicResource MutedText}" FontFamily="Cascadia Code, Consolas, monospace" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Custom Rename Input -->
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="EDIT / RENAME FILE (TYPE CUSTOM NAME):" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" FontFamily="Cascadia Code, Consolas, monospace" />
                        <Border Grid.Column="1" Background="{DynamicResource AccentLight}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="Editable Input Box" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" />
                        </Border>
                    </Grid>
                    <TextBox x:Name="CustomFileNameBox" 
                             Watermark="Type your desired filename here..."
                             Background="{DynamicResource SidebarBackground}" 
                             Foreground="{DynamicResource PrimaryText}" 
                             BorderBrush="{DynamicResource PrimaryAccent}" 
                             BorderThickness="1.5"
                             CornerRadius="6" 
                             Height="36" 
                             VerticalContentAlignment="Center" 
                             FontSize="12" 
                             FontFamily="Cascadia Code, Consolas, monospace" />
                    <TextBlock x:Name="LiveTargetPreviewText" Text="Target: " FontSize="10.5" Foreground="{DynamicResource SuccessColor}" FontFamily="Cascadia Code, Consolas, monospace" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Options Explanation Grid -->
                <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                    <!-- Auto-Number Card -->
                    <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                        <StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Source="/Assets/Icons/plus-blue.png" Width="12" Height="12" VerticalAlignment="Center" />
                                <TextBlock Text="Auto-Number (1)" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource PrimaryAccent}" />
                            </StackPanel>
                            <TextBlock x:Name="AutoNumberPreviewText" Text="Appends unique counter (e.g. file (1).iso) and downloads alongside existing file." FontSize="10.5" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Overwrite Card -->
                    <Border Grid.Column="1" Background="#0ADC2626" BorderBrush="#30DC2626" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                        <StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Source="/Assets/Icons/trash-red.png" Width="12" Height="12" VerticalAlignment="Center" />
                                <TextBlock Text="Overwrite Existing" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource DangerColor}" />
                            </StackPanel>
                            <TextBlock Text="Replaces and overwrites the existing file on your hard drive with the new download." FontSize="10.5" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Bottom Buttons Bar -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
                <Button Grid.Column="0" Click="OnCancelClicked" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="7" Padding="14,8" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" FontSize="12">
                    Cancel
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Click="OnOverwriteClicked" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource DangerColor}" BorderThickness="1" CornerRadius="7" Padding="14,8">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Overwrite File" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource DangerColor}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnCustomRenameClicked" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="7" Padding="14,8">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <Image Source="/Assets/Icons/check-green.png" Width="11" Height="11" VerticalAlignment="Center" />
                            <TextBlock Text="Save with Edited Name" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnAutoNumberClicked" Background="{DynamicResource PrimaryAccent}" CornerRadius="7" Padding="16,8">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Image Source="/Assets/Icons/arrow-down-blue.png" Width="12" Height="12" VerticalAlignment="Center" />
                            <TextBlock Text="Force Download: Auto-Number" FontWeight="Bold" FontSize="12" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
