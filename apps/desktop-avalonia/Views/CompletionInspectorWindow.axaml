<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartDm.Desktop.Avalonia.ViewModels"
        x:Class="SmartDm.Desktop.Avalonia.Views.CompletionInspectorWindow"
        x:DataType="vm:CompletionInspectorViewModel"
        Icon="/Assets/SDM_2.0_logo.png"
        Title="SmartDM — Download finished"
        Width="720" Height="500" MinWidth="680" MinHeight="470"
        CanResize="True" WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="36"
        Background="{DynamicResource ElevatedBackground}">
    <Grid RowDefinitions="36,*,67">
        <Border Grid.Row="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="15,0" PointerPressed="OnTitleBarPointerPressed">
            <Grid ColumnDefinitions="Auto,*,140">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image Source="/Assets/SDM_2.0_logo.png" Width="18" Height="18"/>
                    <TextBlock Text="SmartDM — Download finished" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20" Spacing="17">
                <Grid ColumnDefinitions="42,*">
                    <Border Width="42" Height="42" Background="#1A247751" CornerRadius="4">
                        <Image Source="/Assets/Icons/check-green.png" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="13,0,0,0" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="Download finished" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                        <TextBlock Text="The file was saved to your selected folder." FontSize="12" Foreground="{DynamicResource SecondaryText}"/>
                    </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="42,*">
                    <Border Width="42" Height="42" Background="{DynamicResource AccentLight}" CornerRadius="4">
                        <Image Source="{Binding Download.IconBitmap}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="13,0,0,0" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Download.Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Download.Domain}" FontSize="11" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,*,*">
                    <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="11">
                        <StackPanel Spacing="5">
                            <TextBlock Text="File size" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                            <TextBlock Text="{Binding PayloadSizeText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="11" Margin="6,0,0,0">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Elapsed" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                            <TextBlock Text="{Binding ElapsedTimeText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="11" Margin="6,0,0,0">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Average speed" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                            <TextBlock Text="{Binding AvgSpeedText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <StackPanel Spacing="8">
                    <TextBlock Text="Save location" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/>
                    <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding SavedLocation}" FontSize="11" Foreground="{DynamicResource PrimaryText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Click="OnCopyPathClicked" Content="Copy path" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryAccent}" FontSize="11" Padding="5,0"/>
                        </Grid>
                    </Border>
                </StackPanel>
                <Button Command="{Binding ToggleVerificationCommand}" Content="{Binding VerificationButtonText}" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryAccent}" FontSize="12" FontWeight="SemiBold" Padding="0,3"/>
                <StackPanel IsVisible="{Binding ShowVerificationDetails}" Spacing="10">
                    <TextBlock Text="Verification" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/>
                    <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4">
                        <StackPanel>
                            <StackPanel Margin="12,9" Spacing="3">
                                <TextBlock Text="Transfer completed" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/>
                                <TextBlock Text="The download reached its completed state." FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                            </StackPanel>
                            <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="12,9">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="SHA-256 comparison" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/>
                                    <TextBlock Text="{Binding HashVerificationStatus}" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                                    <TextBlock Text="{Binding Sha256Hash}" FontSize="10" Foreground="{DynamicResource MutedText}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="12,9">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Safety scan" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/>
                                    <TextBlock Text="{Binding DefenderStatus}" FontSize="11" Foreground="{DynamicResource SecondaryText}"/>
                                    <TextBlock Text="{Binding HeuristicStatus}" FontSize="11" Foreground="{DynamicResource MutedText}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="24,0" Background="{DynamicResource ElevatedBackground}">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding QuickOpenFileCommand}" Content="Open file" Background="{DynamicResource PrimaryAccent}" Foreground="White" CornerRadius="4" Padding="13,8"/>
                    <Button Command="{Binding OpenEnclosingFolderCommand}" Content="Open folder" CornerRadius="4" Padding="13,8"/>
                    <Button Content="Extract to Archives" IsEnabled="False" ToolTip.Tip="Extraction is not yet available" CornerRadius="4" Padding="13,8"/>
                </StackPanel>
                <Button Grid.Column="2" Command="{Binding DismissCommand}" Content="Close" CornerRadius="4" Padding="13,8"/>
            </Grid>
        </Border>
    </Grid>
</Window>
