<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartDm.Desktop.Avalonia.ViewModels"
        xmlns:models="using:SmartDm.Desktop.Avalonia.Models"
        xmlns:controls="using:SmartDm.Desktop.Avalonia.Controls"
        x:Class="SmartDm.Desktop.Avalonia.Views.TransferMonitorWindow"
        x:DataType="vm:TransferMonitorViewModel"
        Icon="/Assets/SDM_2.0_logo.png"
        Title="SmartDM 2.0 â€¢ Active Transfer Monitor"
        Width="920" Height="740"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ElevatedBackground}">

    <Grid RowDefinitions="Auto,*">
        <!-- Titlebar -->
        <Border Grid.Row="0" Height="40" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image Source="/Assets/SDM_2.0_logo.png" Width="18" Height="18" />
                    <TextBlock Text="SmartDM 2.0 â€¢ Active Transfer Monitor" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource PrimaryText}" />
                    <Border Background="#1A16A34A" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="â— Concurrency Active" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessColor}" />
                    </Border>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding CloseCommand}" Background="Transparent" BorderThickness="0" Content="✕" FontSize="12" Foreground="{DynamicResource MutedText}" />
            </Grid>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" Padding="22">
            <StackPanel Spacing="16">
                <!-- Top Summary Card -->
                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Width="44" Height="44" Background="{DynamicResource AccentLight}" CornerRadius="10" Margin="0,0,14,0">
                                <TextBlock Text="ðŸ’¿" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Download.Title}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryText}" />
                                    <Border Background="{DynamicResource AccentLight}" CornerRadius="4" Padding="6,1">
                                        <TextBlock Text="16 SEGMENTS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Protocol: HTTP/2 TLS 1.3 â€¢ ALPN Multiplexed" FontSize="11" Foreground="{DynamicResource MutedText}" FontFamily="Cascadia Code, Consolas, monospace" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Download.FormattedSpeed}" FontWeight="ExtraBold" FontSize="22" Foreground="{DynamicResource SuccessColor}" HorizontalAlignment="Right" FontFamily="Cascadia Code, Consolas, monospace" />
                                <TextBlock Text="{Binding Download.FormattedEta}" FontSize="11" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Right" FontFamily="Cascadia Code, Consolas, monospace" />
                            </StackPanel>
                        </Grid>

                        <ProgressBar Value="{Binding Download.ProgressPercentage}" Minimum="0" Maximum="100" Height="8" Foreground="{DynamicResource PrimaryAccent}" Background="{DynamicResource SidebarBackground}" />
                        
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Download.FormattedProgress}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" FontFamily="Cascadia Code, Consolas, monospace" />
                            <TextBlock Grid.Column="1" Text="Direct DMA NVMe Ring Buffer" FontSize="11" Foreground="{DynamicResource MutedText}" FontFamily="Cascadia Code, Consolas, monospace" />
                        </Grid>

                        <!-- Controls -->
                        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <Button Command="{Binding TogglePauseCommand}" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="7" Padding="14,7" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Content="{Binding PauseButtonText}" />
                                    <Button Command="{Binding CloseCommand}" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="7" Padding="14,7" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Content="â¹ Stop" />
                                    <Button Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="7" Padding="14,7" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Content="âš¡ Turbo Flush" />
                                </StackPanel>

                                <Button Grid.Column="2" Command="{Binding SimulateFinishCommand}" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource SuccessColor}" BorderThickness="1" CornerRadius="7" Padding="14,7" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessColor}" Content="âœ“ Simulate Finished State" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 16-Segment Slicing Visualizer -->
                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="âš¡ 16 Parallel Stream Segments (Chunk Buffers)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" />
                            <TextBlock Grid.Column="1" Text="Chunk Size: 352.6 MB each" FontSize="11" Foreground="{DynamicResource MutedText}" FontFamily="Cascadia Code, Consolas, monospace" />
                        </Grid>

                        <!-- Segment Bar (16 Slices) -->
                        <ItemsControl ItemsSource="{Binding SegmentProgressList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="16" Height="22" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="x:Double">
                                    <Border Background="{DynamicResource AccentLight}" CornerRadius="3" Margin="1" ClipToBounds="True">
                                        <ProgressBar Value="{Binding}" Minimum="0" Maximum="100" Height="22" Foreground="{DynamicResource PrimaryAccent}" Background="Transparent" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 4x4 Sockets Grid -->
                        <ItemsControl ItemsSource="{Binding ThreadMetrics}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:ThreadMetric">
                                    <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="5" Padding="6" Margin="2" Height="40">
                                        <Grid RowDefinitions="Auto,Auto">
                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding ThreadName}" FontSize="9.5" Foreground="{DynamicResource MutedText}" FontFamily="Cascadia Code, Consolas, monospace" />
                                                <TextBlock Grid.Column="1" Text="â—" FontSize="8" Foreground="{DynamicResource SuccessColor}" />
                                            </Grid>
                                            <TextBlock Grid.Row="1" Text="{Binding FormattedSpeed}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" FontFamily="Cascadia Code, Consolas, monospace" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Speed Limiter & Sparkline -->
                <Grid ColumnDefinitions="*,*">
                    <!-- Sparkline -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Transfer Pulse (Last 60s)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" />
                            <Border Height="55">
                                <controls:SparklineControl Points="{Binding SparklineHistory}" Height="55" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Throttle Slider -->
                    <Border Grid.Column="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="8,0,0,0">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Bandwidth Limiter" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" />
                                <TextBlock Grid.Column="1" Text="{Binding SpeedLimitLabel}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" FontFamily="Cascadia Code, Consolas, monospace" />
                            </Grid>
                            <Slider Value="{Binding SpeedLimit}" Minimum="5" Maximum="120" />
                            <Grid ColumnDefinitions="*,*,*,*">
                                <TextBlock Grid.Column="0" Text="5 MB/s" FontSize="9.5" Foreground="{DynamicResource MutedText}" />
                                <TextBlock Grid.Column="1" Text="25 MB/s" FontSize="9.5" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="50 MB/s" FontSize="9.5" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="Unlimited" FontSize="9.5" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
