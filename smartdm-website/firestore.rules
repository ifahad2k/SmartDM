rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Security Helper Functions
    // =========================================================================
    
    // Checks if the user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Checks if the user is authenticated AND has a verified email address
    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Checks if the user carries an active admin claim (request.auth.token.admin == true)
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Checks if the authenticated user matches the specified user ID
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // =========================================================================
    // Default Security Policy
    // =========================================================================

    // Deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Collection Rules
    // =========================================================================

    // 1. Public Site Configuration (publicConfig/main)
    // - Public read access to main configuration document
    // - Restricted write access (create, update, delete) to admins with custom token claim
    match /publicConfig/{configId} {
      allow read: if configId == 'main';
      allow write: if configId == 'main' && isAdmin();
    }

    // 2. User Profiles (users/{userId})
    // - Users can read & update their own profile data; admins can view profiles
    // - Deletion is denied
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // 3. User Feedback & Bug Reports (feedback/{id})
    // - Verified users can create feedback where createdBy matches their auth.uid and status is 'new'
    // - Users can read & update their own feedback only while status remains 'new'
    // - Admins have full read, update, and triage privileges across all feedback items
    // - Client deletion is denied
    match /feedback/{feedbackId} {
      allow create: if isVerifiedUser()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == "new";

      allow read: if isOwner(resource.data.createdBy) || isAdmin();

      allow update: if (
        isOwner(resource.data.createdBy)
        && resource.data.status == "new"
        && request.resource.data.status == "new"
        && request.resource.data.createdBy == resource.data.createdBy
      ) || isAdmin();

      allow delete: if false;
    }

    // 4. Audit Logs (auditLogs/{id})
    // - Admin write access (create) to audit log entries
    // - Admin read access for security governance and compliance checks
    // - Client updates and deletions are strictly forbidden
    match /auditLogs/{auditId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
